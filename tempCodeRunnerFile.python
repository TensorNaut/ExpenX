import numpy as np

class Perceptron:
    """
    A simple Perceptron class for binary classification.
    """

    def __init__(self, input_size, learning_rate=0.1):
        """
        Initializes the Perceptron.

        Args:
            input_size (int): The number of features in the input data.
                              For this problem, it's 8 because we use 8-bit ASCII.
            learning_rate (float): The step size for weight updates during training.
        """
        # Initialize weights and bias with small random values.
        # Adding 1 to input_size for the bias weight.
        self.weights = np.random.rand(input_size + 1)
        self.learning_rate = learning_rate
        print(f"Perceptron initialized with {input_size} inputs.")
        print(f"Initial weights (including bias): {self.weights}")

    def _step_function(self, x):
        """
        The activation function.
        Returns 1 if x is positive or zero, otherwise 0.
        """
        return 1 if x >= 0 else 0

    def predict(self, inputs):
        """
        Makes a prediction for a given set of inputs.

        Args:
            inputs (np.array): A single input vector.

        Returns:
            int: The predicted class (1 for even, 0 for odd).
        """
        # Add a bias input (always 1) to the inputs vector.
        inputs_with_bias = np.insert(inputs, 0, 1)
        
        # Calculate the weighted sum of the inputs.
        summation = np.dot(inputs_with_bias, self.weights)
        
        # Pass the sum through the activation function to get the prediction.
        return self._step_function(summation)

    def train(self, training_inputs, labels, epochs=100):
        """
        Trains the Perceptron on the training data.

        Args:
            training_inputs (np.array): A 2D array of input vectors.
            labels (np.array): The corresponding correct labels for the inputs.
            epochs (int): The number of times to loop through the entire dataset.
        """
        print("\n--- Starting Training ---")
        for epoch in range(epochs):
            total_error = 0
            for inputs, label in zip(training_inputs, labels):
                # Make a prediction.
                prediction = self.predict(inputs)
                
                # Calculate the error.
                error = label - prediction
                total_error += abs(error)

                # Update the weights and bias.
                # The bias is the first weight in our combined weights array.
                inputs_with_bias = np.insert(inputs, 0, 1)
                self.weights += self.learning_rate * error * inputs_with_bias
            
            # If there was no error in an entire epoch, the model has converged.
            if total_error == 0:
                print(f"Training converged successfully at epoch {epoch + 1}.")
                break
        
        print("--- Training Complete ---")
        print(f"Final weights (including bias): {self.weights}\n")


def prepare_data():
    """
    Prepares the dataset for the even/odd number problem.
    The features are the 8 bits of the ASCII value for digits '0' through '9'.
    """
    inputs = []
    labels = []
    
    print("--- Preparing Data ---")
    print("Digit | ASCII | Binary Rep. | Label (1=Even, 0=Odd)")
    print("-----------------------------------------------------")

    for i in range(10): # For digits 0 through 9
        # Get the ASCII value of the digit character (e.g., '0' -> 48)
        ascii_val = ord(str(i))
        
        # Convert the ASCII value to an 8-bit binary string (e.g., 48 -> "00110000")
        binary_str = format(ascii_val, '08b')
        
        # Convert the binary string to a numpy array of integers (the features)
        binary_features = np.array([int(bit) for bit in binary_str])
        inputs.append(binary_features)
        
        # Assign the label: 1 if the number is even, 0 if it's odd
        label = 1 if i % 2 == 0 else 0
        labels.append(label)

        print(f"  {i}   |  {ascii_val}  | {binary_str} |          {label}")

    return np.array(inputs), np.array(labels)


if __name__ == '__main__':
    # 1. Prepare the dataset
    training_data, training_labels = prepare_data()
    
    # The number of input features is the number of columns in our data.
    num_inputs = training_data.shape[1]

    # 2. Initialize the Perceptron
    # Set a random seed for reproducibility of initial weights
    np.random.seed(42)
    perceptron = Perceptron(input_size=num_inputs, learning_rate=0.1)

    # 3. Train the Perceptron
    perceptron.train(training_data, training_labels, epochs=100)

    # 4. Test the trained Perceptron
    print("--- Testing Trained Perceptron ---")
    print("Digit | Expected | Predicted | Result")
    print("-----------------------------------------")
    for i in range(10):
        # We can reuse the data we already generated
        test_input = training_data[i]
        expected_label = training_labels[i]
        
        # Get the prediction from our trained model
        prediction = perceptron.predict(test_input)

        # Format the output for clarity
        expected_str = "Even" if expected_label == 1 else "Odd"
        predicted_str = "Even" if prediction == 1 else "Odd"
        result_str = "Correct" if expected_label == prediction else "Incorrect"
        
        print(f"  {i}   | {expected_str:^8} | {predicted_str:^9} | {result_str}")

